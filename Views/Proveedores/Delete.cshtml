@model SourcingManager.Models.Proveedor

@{
    ViewData["Title"] = "Eliminar proveedor";
}

<div class="page-header">
    <div>
        <span class="page-kicker">Eliminación</span>
        <h1 class="page-title">Eliminar proveedor</h1>
        <p class="page-subtitle">Esta acción no se puede deshacer.</p>
    </div>
</div>

<div class="page-panel form-panel">
    <div class="delete-banner">
        ¿Seguro que quieres eliminar este proveedor de la cartera?
    </div>

    <dl class="details-list">
        <dt>@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd>@Html.DisplayFor(model => model.Nombre)</dd>

        <dt>RUC / NIT</dt>
        <dd><code>@Html.DisplayFor(model => model.RucONit)</code></dd>

        <dt>@Html.DisplayNameFor(model => model.Email)</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</dd>

        <dt>@Html.DisplayNameFor(model => model.Telefono)</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.Telefono) ? "—" : Model.Telefono)</dd>

        <dt>@Html.DisplayNameFor(model => model.Direccion)</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.Direccion) ? "—" : Model.Direccion)</dd>

        <dt>Categoría</dt>
        <dd>
            <span class="badge-category">@Html.DisplayFor(model => model.CategoriaProveedor.Nombre)</span>
        </dd>
    </dl>

    <form asp-action="Delete" class="form-actions">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Sí, eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
